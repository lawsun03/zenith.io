# Secrets
.env

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/

# Frontend dependencies
frontend/node_modules/

# Test/analysis caches
.pytest_cache/
.hypothesis/

# Bars data (large CSVs, re-fetchable)
bars/
intrabar_*.csv

# Live trade logs (regenerated from broker every session)
# trades/ intentionally tracked — CSVs committed daily for cloud analysis

# Backtest results (generated data) — keep _config_* strategy configs
backtests/*.json
!backtests/_config_*.json
backtest_results/
walkforward_*/

# Logs
logs/
*.log
bot_stdout.log
bot_stderr.log

# Claude internal
.claude/

# Plugins / skills local state
.superpowers/

# Runtime
*.pid

# Frontend build output (vite outDir → app/api/static; rebuild with `npm run build`)
app/api/static/

# Misc
Capture.PNG

# scratch / debug artifacts
/*.png
.playwright-mcp/
scripts/_*.py
research/STOP

# live account config + trade logs (kept local, never tracked)
bot_config.json
config_presets.json
trades/
backtests/_config_*.json

# Databento raw pulls + continuous-series cache (re-derivable, never committed).
# var/databento/continuous/*/holdout/ is additionally sealed with filesystem
# permissions once populated — see docs/research-loop/README.md.
/var/databento/

# Research ledger DB — runtime state generated from docs/research-loop/ledger.sql,
# never committed. The DDL is the spec; this file is not.
/var/ledger/

# Anomaly table + Grok spend log — runtime state rebuilt by
# scripts/run_anomaly_pass.py, never committed.
/var/anomaly/
.venv/
