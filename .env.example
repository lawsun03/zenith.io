# topstep-bot environment template
# Copy this to .env (in the repo root) and fill in your values.
# .env is sourced by deploy/windows/start.bat at task launch.
#
# Format rules:
#   - One KEY=value per line.
#   - No quotes around values.
#   - No spaces around the = sign.
#   - Lines starting with # are comments; blank lines are ignored.

# === Required: project_x_py SDK credentials (live mode only) ===
PROJECT_X_API_KEY=
PROJECT_X_USERNAME=

# === Required: bot mode and instrument ===
TOPSTEP_BOT_MODE=live
TOPSTEP_BOT_INSTRUMENT=MGC

# === Optional overrides (defaults shown) ===
TOPSTEP_BOT_TIMEFRAMES=1min
TOPSTEP_BOT_SOFT_BUFFER=500
TOPSTEP_BOT_RECONCILE_SECS=30
TOPSTEP_BOT_LOG_LEVEL=INFO
TOPSTEP_BOT_PORT=5174

# === Paper mode only — path to historical bar CSV ===
# TOPSTEP_BOT_PAPER_BARS=C:\path\to\bars.csv

# === Optional: Databento historical data (backtest data source) ===
# Get your API key at https://databento.com/portal
# Used by the Backtests page "Databento" data source toggle.
# DATABENTO_API_KEY=db-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# === Optional: email notifications (trade alerts + end-of-day summary) ===
# All four must be set or notifications silently no-op.
# For Gmail: enable 2FA, then create an App Password at
#   https://myaccount.google.com/apppasswords  and use that as SMTP_PASS.
# TOPSTEP_BOT_SMTP_HOST=smtp.gmail.com
# TOPSTEP_BOT_SMTP_PORT=587
# TOPSTEP_BOT_SMTP_USER=youraddress@gmail.com
# TOPSTEP_BOT_SMTP_PASS=your-app-password
# TOPSTEP_BOT_NOTIFY_EMAIL=where-to-send@example.com

# === Optional: Discord notifications (signals + entry/exit fills) ===
# Set to a Discord channel webhook URL. Unset (or empty) = disabled.
# TOPSTEP_BOT_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# === Optional: sync to DigitalOcean for durable journaling ===
# Both endpoint and secret must be set together (or both unset).
# Endpoint must accept POST with HMAC-SHA256-signed body.
# TOPSTEP_BOT_SYNC_ENDPOINT=https://your-do-app.example.com/api/bot/events
# TOPSTEP_BOT_SYNC_HMAC_SECRET=long-random-string-shared-with-do
# TOPSTEP_BOT_OUTBOX_PATH=./outbox.db
# TOPSTEP_BOT_BOT_ID=lawrence-mgc
